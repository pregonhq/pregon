# Copy to .env and set the secrets. Never commit .env.
# Required — compose refuses to start without it (ADR-0020).
POSTGRES_PASSWORD=

# Optional — tunable parameters; remove a line to use the documented default.
PREGON_LANGUAGE=es
PREGON_STT_MODEL=small
PREGON_STT_DEVICE=cpu
PREGON_STT_COMPUTE_TYPE=int8
PREGON_RETENTION_AUDIO=delete-after-transcription
PREGON_RETENTION_TRANSCRIPTS=none
